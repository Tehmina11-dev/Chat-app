# ==================================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit your actual .env file to version control!

# ==================================================
# SERVER CONFIGURATION
# ==================================================
NODE_ENV=production
PORT=4000

# ==================================================
# DATABASE CONFIGURATION
# ==================================================
# PostgreSQL Connection String (Neon or local PostgreSQL)
# Local Docker: postgresql://chatuser:chatpass123@postgres:5432/chatdb
# Neon Cloud: postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://chatuser:chatpass123@postgres:5432/chatdb

# ==================================================
# SECURITY & AUTHENTICATION
# ==================================================
# JWT Secret for signing authentication tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-strong-random-32-byte-hex-string-here

# Session Secret for session management
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-a-strong-random-32-byte-hex-string-here

# ==================================================
# EXTERNAL API KEYS
# ==================================================
# OpenAI API Key - Required for embeddings and chat
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# GROQ API Key - Optional, for faster inference on supported models
GROQ_API_KEY=gsk_your-groq-api-key-here

# ==================================================
# WEAVIATE VECTOR DATABASE (AI/RAG Backend)
# ==================================================
# Scheme: http or https
# In Docker: use 'weaviate' as hostname (service name in docker-compose)
# In Production: use full cloud URL
WEAVIATE_SCHEME=http
WEAVIATE_HOST=weaviate:8080

# API Key for Weaviate (if authentication is enabled)
# Leave empty if anonymous access is enabled in Weaviate
WEAVIATE_API_KEY=your-weaviate-api-key-here

# ==================================================
# RATE LIMITING
# ==================================================
# Time window for rate limiting (in milliseconds)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per time window
RATE_LIMIT_MAX=100

# ==================================================
# OPTIONAL CONFIGURATION
# ==================================================
# Enable detailed logging (true/false)
# DEBUG=false

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
